{
	"name": "jazzerjs-value-profiling-example",
	"version": "1.0.0",
	"description": "An example showing how Jazzer.js handles integer comparisons in the code",
	"scripts": {
		"fuzz": "jazzer fuzz --engine=libfuzzer --sync --disableBugDetectors='.*' -x Error --runs=4000000 --seed=1428686921 --libFuzzerOptions=-use_value_profile=1",
		"dryRun": "jazzer fuzz --engine=libfuzzer --sync --runs=100 --seed=123456789 --libFuzzerOptions=-use_value_profile=1"
	},
	"devDependencies": {
		"@jazzer.js/core": "file:../../packages/core"
	}
}
