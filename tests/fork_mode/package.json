{
	"name": "jazzerjs-fork-mode-example",
	"version": "1.0.0",
	"description": "An example showing how to use libFuzzer's fork mode in Jazzer.js",
	"scripts": {
		"fuzz": "jazzer fuzz --engine=libfuzzer --sync --disableBugDetectors='.*' --libFuzzerOptions=-fork=3",
		"dryRun": "jazzer fuzz --engine=libfuzzer --sync --runs=100 --seed=123456789 --libFuzzerOptions=-fork=3"
	},
	"devDependencies": {
		"@jazzer.js/core": "file:../../packages/core"
	}
}
