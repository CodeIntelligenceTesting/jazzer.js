{
	"name": "ssrf-example",
	"version": "1.0.0",
	"scripts": {
		"fuzz": "jazzer fuzz -h config.js --timeout=60000 -x Error --runs=1000000 --libFuzzerOptions=-print_final_stats=1 --libFuzzerOptions=-use_value_profile=1 --libFuzzerOptions=-rss_limit_mb=10000",
		"fuzzShowError": "jazzer fuzz -h config.js --timeout=60000 --runs=1000000 --libFuzzerOptions=-print_final_stats=1 --libFuzzerOptions=-use_value_profile=1 --libFuzzerOptions=-rss_limit_mb=10000",
		"dryRun": "jazzer fuzz --runs=100000000 --seed=123456789"
	},
	"devDependencies": {
		"@jazzer.js/core": "file:../../../packages/core"
	}
}
