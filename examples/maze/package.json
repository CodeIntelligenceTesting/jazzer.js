{
	"name": "jazzerjs-maze-example",
	"type": "module",
	"version": "1.0.0",
	"description": "An example showing you can give Jazzer.js more feedback signals to reach deep program states",
	"scripts": {
		"fuzz": "jazzer fuzz --sync --libFuzzerOptions=-use_value_profile=1",
		"dryRun": "jazzer fuzz --sync --runs=100 --seed=123456789 --libFuzzerOptions=-use_value_profile=1"
	},
	"devDependencies": {
		"@jazzer.js/core": "file:../../packages/core"
	}
}
